@startuml
' Data Flow Diagram (Level 1) — Recipe Generation Pipeline
' Section 3.3 Data Design — BSc Thesis (ELTE)

skinparam backgroundColor #FFFFFF
skinparam actorBackgroundColor #FFFFFF
skinparam actorBorderColor #000000
skinparam databaseBackgroundColor #FFFFFF
skinparam databaseBorderColor #000000
skinparam rectangleBackgroundColor #FFFFFF
skinparam rectangleBorderColor #000000
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseBorderColor #000000
skinparam arrowColor #000000
skinparam defaultFontColor #000000
skinparam defaultFontSize 11
skinparam padding 6
skinparam nodesep 20
skinparam ranksep 24
skinparam dpi 200

' ── External Entities ──────────────────────────────

rectangle "User\n(Browser Client)" as User
rectangle "OpenAI API\n(ChatCompletion,\nEmbeddings, DALL-E)" as OpenAI

' ── Processes ──────────────────────────────────────

usecase "1.0\nValidate &\nFilter" as P1
usecase "2.0\nRetrieve\nContext" as P2
usecase "3.0\nGenerate\nRecipe" as P3
usecase "4.0\nValidate\nOutput" as P4
usecase "5.0\nGenerate\nThumbnail" as P5
usecase "6.0\nPersist\nResult" as P6

' ── Data Stores ────────────────────────────────────

database "D1: SQLite\ngenerated_recipes" as D1
database "D2: ChromaDB\nrecipe_knowledge_base" as D2
database "D3: Media Store\nrecipe_thumbnails/" as D3

' ── Data Flows ─────────────────────────────────────

User --> P1 : ingredients[], preferences[], allergies[]

P1 --> P2 : safe_ingredients[], preferences[], allergies[]

P2 --> OpenAI : query_text
OpenAI --> P2 : query_embedding

P2 --> D2 : query_embedding, n_results
D2 --> P2 : metadatas[], distances[]

P2 --> P3 : ranked_context[], restrictions{}

P3 --> OpenAI : messages[]
OpenAI --> P3 : recipe_text (JSON)

P3 --> P4 : recipe_json {title, ingredients[],\nsteps[], nutrition_estimate{}}

P4 --> P3 : violation_note [violations found]

P4 --> P5 : RecipeResponse {title, ingredients[],\nsteps[], warnings[]}

P5 --> OpenAI : image_prompt
OpenAI --> P5 : b64_json (PNG)

P5 --> D3 : {cache_key}.png
D3 --> P5 : cached thumbnail

P5 --> P6 : RecipeResponse + image_url,\nimage_cache_key

P6 --> D1 : GeneratedRecipe {fingerprint, title,\ningredients, nutrition, user_id}
D1 --> P6 : generated_recipe_id

P6 --> User : RecipeResponse {generated_recipe_id,\ntitle, ingredients[], steps[],\nnutrition_estimate{}, image_url, warnings[]}

@enduml
