@startuml

skinparam classAttributeIconSize 0
skinparam backgroundColor #FFFFFF
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #FFFFFF
skinparam packageBackgroundColor #FFFFFF
skinparam classBorderColor #000000
skinparam classArrowColor #000000
skinparam packageBorderColor #000000
skinparam fontColor #000000
skinparam classFontColor #000000
skinparam classAttributeFontColor #000000
skinparam packageFontColor #000000
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam packageFontSize 12
skinparam classFontStyle bold
skinparam nodesep 50
skinparam ranksep 70
skinparam padding 8

top to bottom direction

namespace ExternalBases {

    abstract class BaseSettings <<abstract>> {
    }

    abstract class BaseHTTPMiddleware <<abstract>> {
    }

}

namespace ConfigLayer {

    class Settings {
        +str openai_api_key
        +str openai_model
        +str openai_embedding_model
        +str openai_image_model
        +str ocr_provider
        +str database_url
        +str secret_key
        +str algorithm
        +str frontend_origin
        +str chroma_collection_name
        +int rag_candidate_count
        +int rag_context_count
        +int default_rate_limit_requests
        +int default_rate_limit_window_seconds
        +int auth_rate_limit_requests
        +int auth_rate_limit_window_seconds
        +int generate_rate_limit_requests
        +int generate_rate_limit_window_seconds
        +int ocr_extract_rate_limit_requests
        +int ocr_extract_rate_limit_window_seconds
        +{static} str secret_key_must_be_set(str value)
    }

}

namespace MiddlewareLayer {

    class RateLimitRule {
        +int max_requests
        +int window_seconds
    }

    class InMemoryRateLimiter {
        -dict _requests
        -Lock _lock
        +tuple<bool, int> check(str key, RateLimitRule rule)
    }

    class RateLimitMiddleware {
        +RateLimitRule default_rule
        +dict<str, RateLimitRule> route_rules
        +InMemoryRateLimiter rate_limiter
        +Response dispatch(Request request, Callable call_next)
        -RateLimitRule _resolve_rule(Request request)
        -{static} str _get_client_identifier(Request request)
    }

}

namespace AuthSchemas {

    class UserCreate {
        +EmailStr email
        +str password
    }

    class UserResponse {
        +int id
        +EmailStr email
        +list<str> preferences
        +list<str> allergies
        +datetime created_at
    }

    class UserLogin {
        +EmailStr email
        +str password
    }

    class TokenResponse {
        +str access_token
        +str token_type
    }

    class UserProfileUpdate {
        +list<str> preferences
        +list<str> allergies
    }

}

namespace RecipeSchemas {

    class NutritionEstimate {
        +int calories
        +str protein
        +str carbs
        +str fat
    }

    class RecipeRequest {
        +list<str> ingredients
        +list<str> preferences
        +list<str> allergies
        +{static} list<str> validate_string_list(list<str> values)
        +{static} list<str> validate_ingredients_not_empty_after_cleaning(list<str> values)
        +{static} list<str> validate_optional_list_size(list<str> values)
    }

    class RecipeResponse {
        +int generated_recipe_id
        +str title
        +list<str> ingredients
        +list<str> additional_ingredients
        +list<str> preferences
        +list<str> allergies
        +list<str> steps
        +NutritionEstimate nutrition_estimate
        +str image_url
        +str image_cache_key
        +list<str> warnings
    }

    class SavedRecipeCreate {
        +int generated_recipe_id
    }

    class SavedRecipeResponse {
        +int id
        +str title
        +list<str> ingredients
        +list<str> additional_ingredients
        +list<str> preferences
        +list<str> allergies
        +list<str> steps
        +NutritionEstimate nutrition
        +str image_url
        +str image_cache_key
        +datetime saved_at
        +datetime created_at
    }

    class GeneratedRecipeHistoryResponse {
        +int id
        +str fingerprint
        +str title
        +list<str> ingredients
        +list<str> additional_ingredients
        +list<str> preferences
        +list<str> allergies
        +list<str> steps
        +NutritionEstimate nutrition
        +list<str> warnings
        +str image_url
        +str image_cache_key
        +bool is_saved
        +datetime saved_at
        +datetime created_at
    }

    class "PaginatedResponse<T>" as PaginatedResponse {
        +list<T> items
        +int total
        +int page
        +int page_size
        +int total_pages
    }

}

namespace OcrSchemas {

    class NutritionLabelData {
        +str product_name
        +str serving_size
        +int calories
        +float protein_g
        +float carbs_g
        +float fat_g
        +float sugar_g
        +float sodium_mg
        +float fiber_g
    }

    class OcrExtractionResponse {
        +str raw_text
        +NutritionLabelData structured_nutrition
        +str image_url
        +str image_path
    }

    class SavedOcrExtractionCreate {
        +str source_filename
        +str raw_text
        +NutritionLabelData structured_nutrition
        +str image_url
        +str image_path
    }

    class SavedOcrExtractionResponse {
        +int id
        +str source_filename
        +str raw_text
        +NutritionLabelData structured_nutrition
        +str image_url
        +datetime created_at
    }

}

namespace RagDebugRouteModels {

    class VectorSearchResult {
        +int rank
        +str recipe_id
        +str title
        +list<str> ingredients
        +list<str> tags
        +str instruction_summary
        +float semantic_score
        +int preference_matches
        +float ranking_score
        +bool allergy_conflict
        +bool selected_for_context
    }

    class RagDebugResponse {
        +str query_text
        +int collection_size
        +int candidates_retrieved
        +int candidates_after_allergy_filter
        +int candidates_selected
        +dict generation_restrictions
        +list<VectorSearchResult> results
    }

}

' ══ Inheritance ══
ConfigLayer.Settings --|> ExternalBases.BaseSettings : extends
MiddlewareLayer.RateLimitMiddleware --|> ExternalBases.BaseHTTPMiddleware : extends

' ══ Composition ══
MiddlewareLayer.RateLimitMiddleware "1" *-- "1" MiddlewareLayer.InMemoryRateLimiter : uses
RecipeSchemas.RecipeResponse "1" *-- "1" RecipeSchemas.NutritionEstimate : contains
RecipeSchemas.SavedRecipeResponse "1" *-- "1" RecipeSchemas.NutritionEstimate : contains
RecipeSchemas.GeneratedRecipeHistoryResponse "1" *-- "1" RecipeSchemas.NutritionEstimate : contains
OcrSchemas.OcrExtractionResponse "1" *-- "1" OcrSchemas.NutritionLabelData : contains
OcrSchemas.SavedOcrExtractionCreate "1" *-- "1" OcrSchemas.NutritionLabelData : contains
OcrSchemas.SavedOcrExtractionResponse "1" *-- "1" OcrSchemas.NutritionLabelData : contains
RagDebugRouteModels.RagDebugResponse "1" *-- "0..*" RagDebugRouteModels.VectorSearchResult : contains

' ══ Aggregation ══
MiddlewareLayer.RateLimitMiddleware "1" o-- "1..*" MiddlewareLayer.RateLimitRule : default + route rules

' ══ Dependency ══
MiddlewareLayer.InMemoryRateLimiter ..> MiddlewareLayer.RateLimitRule : checks against

@enduml
