                  "if (data.generated_recipe_id) {",
                  "  pm.collectionVariables.set('generatedRecipeId', data.generated_recipe_id);",
                  "}",
                  "pm.test('Recipe response has structured fields', function () {",
                  "  pm.expect(data.title).to.be.a('string').and.not.empty;",
                  "  pm.expect(data.ingredients).to.be.an('array');",
                  "  pm.expect(data.steps).to.be.an('array').and.not.empty;",
