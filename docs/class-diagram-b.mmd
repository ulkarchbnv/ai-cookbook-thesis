classDiagram
    direction TB

    %% ════════════════════════════════════════════════════════════
    %% Diagram B — Schemas, Configuration, and Middleware
    %% ════════════════════════════════════════════════════════════

    %% ── External Base Classes ────────────────────

    namespace ExternalBases {
        class BaseSettings {
            <<abstract>>
        }
        class BaseHTTPMiddleware {
            <<abstract>>
        }
    }

    %% ── Configuration (config.py) ────────────────
    %% simplified for clarity

    namespace ConfigLayer {
        class Settings {
            +str openai_api_key
            +str openai_model
            +str openai_embedding_model
            +str openai_image_model
            +str ocr_provider
            +str database_url
            +str secret_key
            +str algorithm
            +str frontend_origin
            +str chroma_collection_name
            +int rag_candidate_count
            +int rag_context_count
            +int default_rate_limit_requests
            +int default_rate_limit_window_seconds
            +int auth_rate_limit_requests
            +int auth_rate_limit_window_seconds
            +int generate_rate_limit_requests
            +int generate_rate_limit_window_seconds
            +int ocr_extract_rate_limit_requests
            +int ocr_extract_rate_limit_window_seconds
            +str secret_key_must_be_set(str value)$
        }
    }

    %% ── Middleware (rate_limit.py) ────────────────

    namespace MiddlewareLayer {
        class RateLimitRule {
            +int max_requests
            +int window_seconds
        }
        class InMemoryRateLimiter {
            -dict _requests
            -Lock _lock
            +tuple~bool, int~ check(str key, RateLimitRule rule)
        }
        class RateLimitMiddleware {
            +RateLimitRule default_rule
            +dict~str, RateLimitRule~ route_rules
            +InMemoryRateLimiter rate_limiter
            +Response dispatch(Request request, Callable call_next)
            -RateLimitRule _resolve_rule(Request request)
            -str _get_client_identifier(Request request)$
        }
    }

    %% ── Auth Schemas (schemas.py) ────────────────

    namespace AuthSchemas {
        class UserCreate {
            +EmailStr email
            +str password
        }
        class UserResponse {
            +int id
            +EmailStr email
            +list~str~ preferences
            +list~str~ allergies
            +datetime created_at
        }
        class UserLogin {
            +EmailStr email
            +str password
        }
        class TokenResponse {
            +str access_token
            +str token_type
        }
        class UserProfileUpdate {
            +list~str~ preferences
            +list~str~ allergies
        }
    }

    %% ── Recipe Schemas (schemas.py) ──────────────

    namespace RecipeSchemas {
        class NutritionEstimate {
            +int calories
            +str protein
            +str carbs
            +str fat
        }
        class RecipeRequest {
            +list~str~ ingredients
            +list~str~ preferences
            +list~str~ allergies
            +list~str~ validate_string_list(list~str~ values)$
            +list~str~ validate_ingredients_not_empty_after_cleaning(list~str~ values)$
            +list~str~ validate_optional_list_size(list~str~ values)$
        }
        class RecipeResponse {
            +int generated_recipe_id
            +str title
            +list~str~ ingredients
            +list~str~ additional_ingredients
            +list~str~ preferences
            +list~str~ allergies
            +list~str~ steps
            +NutritionEstimate nutrition_estimate
            +str image_url
            +str image_cache_key
            +list~str~ warnings
        }
        class SavedRecipeCreate {
            +int generated_recipe_id
        }
        class SavedRecipeResponse {
            +int id
            +str title
            +list~str~ ingredients
            +list~str~ additional_ingredients
            +list~str~ preferences
            +list~str~ allergies
            +list~str~ steps
            +NutritionEstimate nutrition
            +str image_url
            +str image_cache_key
            +datetime saved_at
            +datetime created_at
        }
        class GeneratedRecipeHistoryResponse {
            +int id
            +str fingerprint
            +str title
            +list~str~ ingredients
            +list~str~ additional_ingredients
            +list~str~ preferences
            +list~str~ allergies
            +list~str~ steps
            +NutritionEstimate nutrition
            +list~str~ warnings
            +str image_url
            +str image_cache_key
            +bool is_saved
            +datetime saved_at
            +datetime created_at
        }
        class PaginatedResponse~T~ {
            +list~T~ items
            +int total
            +int page
            +int page_size
            +int total_pages
        }
    }

    %% ── OCR Schemas (schemas.py) ─────────────────

    namespace OcrSchemas {
        class NutritionLabelData {
            +str product_name
            +str serving_size
            +int calories
            +float protein_g
            +float carbs_g
            +float fat_g
            +float sugar_g
            +float sodium_mg
            +float fiber_g
        }
        class OcrExtractionResponse {
            +str raw_text
            +NutritionLabelData structured_nutrition
            +str image_url
            +str image_path
        }
        class SavedOcrExtractionCreate {
            +str source_filename
            +str raw_text
            +NutritionLabelData structured_nutrition
            +str image_url
            +str image_path
        }
        class SavedOcrExtractionResponse {
            +int id
            +str source_filename
            +str raw_text
            +NutritionLabelData structured_nutrition
            +str image_url
            +datetime created_at
        }
    }

    %% ── RAG Debug Route Models (routes/rag_debug.py) ──

    namespace RagDebugRouteModels {
        class VectorSearchResult {
            +int rank
            +str recipe_id
            +str title
            +list~str~ ingredients
            +list~str~ tags
            +str instruction_summary
            +float semantic_score
            +int preference_matches
            +float ranking_score
            +bool allergy_conflict
            +bool selected_for_context
        }
        class RagDebugResponse {
            +str query_text
            +int collection_size
            +int candidates_retrieved
            +int candidates_after_allergy_filter
            +int candidates_selected
            +dict generation_restrictions
            +list~VectorSearchResult~ results
        }
    }

    %% ═══════════════════════════════════════════════
    %%  RELATIONSHIPS
    %% ═══════════════════════════════════════════════

    %% ── Inheritance ──────────────────────────────

    Settings --|> BaseSettings : extends
    RateLimitMiddleware --|> BaseHTTPMiddleware : extends

    %% ── Composition (owns lifecycle) ─────────────

    RateLimitMiddleware "1" *-- "1" InMemoryRateLimiter : uses
    RecipeResponse "1" *-- "1" NutritionEstimate : contains
    SavedRecipeResponse "1" *-- "1" NutritionEstimate : contains
    GeneratedRecipeHistoryResponse "1" *-- "1" NutritionEstimate : contains
    OcrExtractionResponse "1" *-- "1" NutritionLabelData : contains
    SavedOcrExtractionCreate "1" *-- "1" NutritionLabelData : contains
    SavedOcrExtractionResponse "1" *-- "1" NutritionLabelData : contains
    RagDebugResponse "1" *-- "0..*" VectorSearchResult : contains

    %% ── Aggregation ─────────────────────────────

    RateLimitMiddleware "1" o-- "1..*" RateLimitRule : default + route rules

    %% ── Dependency ──────────────────────────────

    InMemoryRateLimiter ..> RateLimitRule : checks against
