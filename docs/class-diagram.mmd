classDiagram
    direction TB

    %% ════════════════════════════════════════════════
    %% AI Cookbook Backend — Class and Module Overview
    %% ════════════════════════════════════════════════

    %% ── External Base Classes ──────────────────────

    namespace ExternalBases {
        class BaseSettings {
            <<abstract>>
        }
        class BaseHTTPMiddleware {
            <<abstract>>
        }
    }

    %% ── Application Composition (main.py) ─────────

    namespace ApplicationLayer {
        class App {
            <<module>>
            +FastAPI app
            +dict read_root()
        }
    }

    %% ── Middleware (rate_limit.py) ─────────────────

    namespace MiddlewareLayer {
        class RateLimitRule {
            +int max_requests
            +int window_seconds
        }
        class InMemoryRateLimiter {
            -dict _requests
            -Lock _lock
            +tuple~bool, int~ check(str key, RateLimitRule rule)
        }
        class RateLimitMiddleware {
            +RateLimitRule default_rule
            +dict~str, RateLimitRule~ route_rules
            +InMemoryRateLimiter rate_limiter
            +Response dispatch(Request request, Callable call_next)
            -RateLimitRule _resolve_rule(Request request)
            -str _get_client_identifier(Request request)$
        }
    }

    %% ── Presentation Layer (routes/) ──────────────

    namespace PresentationLayer {
        class AuthRouter {
            <<module>>
            +APIRouter router
            +UserResponse signup(UserCreate user, Session db)
            +TokenResponse login(UserLogin user, Session db)
            +TokenResponse login_for_access_token(OAuth2PasswordRequestForm form, Session db)
            +UserResponse read_current_user(User current_user)
            +UserResponse update_current_user_profile(UserProfileUpdate profile, Session db, User current_user)
        }
        class RecipeRouter {
            <<module>>
            +APIRouter router
            +RecipeResponse generate_recipe(RecipeRequest request, Session db, User? current_user)
            +SavedRecipeResponse save_recipe(SavedRecipeCreate recipe, Session db, User current_user)
            +PaginatedResponse list_saved_recipes(int page, int page_size, Session db, User current_user)
            +PaginatedResponse list_generated_recipe_history(int page, int page_size, Session db, User current_user)
        }
        class OcrRouter {
            <<module>>
            +APIRouter router
            +dict get_ocr_status()
            +OcrExtractionResponse extract_nutrition(UploadFile file)
            +SavedOcrExtractionResponse save_ocr_extraction(SavedOcrExtractionCreate data, Session db, User current_user)
            +PaginatedResponse list_saved_ocr_extractions(int page, int page_size, Session db, User current_user)
        }
        class RagDebugRouter {
            <<module>>
            +APIRouter router
            +RagDebugResponse rag_debug(RecipeRequest request)
            +dict rag_collection_stats()
        }
    }

    %% ── Service Layer (services/) ─────────────────

    namespace ServiceLayer {
        class LlmService {
            <<module>>
            +RecipeResponse generate_structured_recipe(RecipeRequest request)
            -str _build_recipe_prompt(RecipeRequest request, str context_block)
            -list~str~ _find_ingredient_drift(dict recipe_json, list~str~ allowed)
            -list~str~ _find_output_restriction_violations(dict recipe_json, dict restrictions)
        }
        class OcrService {
            <<module>>
            +OcrExtractionResponse extract_nutrition_label(UploadFile file)
            -NutritionLabelData _structure_nutrition_text(str raw_text)
            -dict _save_ocr_upload(bytes file_bytes, str original_filename)
            -str _sanitize_ocr_text(str raw_text)
        }
        class EmbeddingService {
            <<module>>
            +list create_embeddings(list~str~ texts)
        }
        class RagService {
            <<module>>
            +dict ALLERGY_ALIASES
            +dict PREFERENCE_CONFLICT_KEYWORDS
            +str build_retrieval_query(RecipeRequest request)
            +list~str~ find_conflicting_ingredients(list~str~ ingredients, list~str~ allergies)
            +dict find_preference_conflicting_ingredients(list~str~ ingredients, list~str~ preferences)
            +dict get_generation_restrictions(list~str~ allergies, list~str~ preferences)
            +dict get_preference_conflict_keywords(list~str~ preferences)
            +list~dict~ retrieve_recipe_context(RecipeRequest request)
        }
        class RecipeImageService {
            <<module>>
            +str build_recipe_image_cache_key(str title, list~str~ ingredients, list~str~ preferences, list~str~ allergies)
            +str build_recipe_image_prompt(str title, list~str~ ingredients, list~str~ preferences, list~str~ allergies)
            +dict ensure_recipe_thumbnail(str title, list~str~ ingredients, list~str~ preferences, list~str~ allergies, list~str~? cache_ingredients)
        }
        class VectorStoreService {
            <<module>>
            +Collection get_collection()
            +str build_recipe_document(dict recipe)
            +dict build_recipe_metadata(dict recipe)
        }
    }

    %% ── Provider Layer (services/) ────────────────

    namespace ProviderLayer {
        class OcrProvider {
            <<abstract>>
            +str extract_text(bytes image_bytes)*
        }
        class GoogleVisionOcrProvider {
            +str extract_text(bytes image_bytes)
        }
        class GoogleVisionHelper {
            <<module>>
            +ImageAnnotatorClient get_google_vision_client()
            +str extract_text_with_google_vision(bytes image_bytes)
        }
        class OcrImageProcessing {
            <<module>>
            +validate_image_file(UploadFile file)
            +validate_image_size(bytes file_bytes)
            +bytes prepare_image_for_ocr(bytes file_bytes)
        }
        class RecipeImageProvider {
            <<abstract>>
            +bytes generate_png(str prompt)*
        }
        class OpenAIRecipeImageProvider {
            -OpenAI _client
            +bytes generate_png(str prompt)
        }
    }

    %% ── Data Layer — ORM Entities (models.py) ─────

    namespace DataLayer {
        class Base {
            <<abstract>>
        }
        class User {
            <<entity>>
            +Integer id
            +String email
            +String password
            +Text preferences
            +Text allergies
            +DateTime created_at
        }
        class GeneratedRecipe {
            <<entity>>
            +Integer id
            +String fingerprint
            +String title
            +Text ingredients
            +Text additional_ingredients
            +Text preferences
            +Text allergies
            +Text steps
            +Text nutrition
            +Text warnings
            +String image_url
            +String image_path
            +String image_cache_key
            +Text image_prompt
            +Boolean is_saved
            +DateTime saved_at
            +DateTime created_at
            +Integer user_id
        }
        class OcrExtraction {
            <<entity>>
            +Integer id
            +String source_filename
            +Text raw_text
            +Text structured_nutrition
            +String image_path
            +String image_url
            +DateTime created_at
            +Integer user_id
        }
    }

    %% ── Auth Schemas (schemas.py) ─────────────────

    namespace AuthSchemas {
        class UserCreate {
            +EmailStr email
            +str password
        }
        class UserResponse {
            +int id
            +EmailStr email
            +list~str~ preferences
            +list~str~ allergies
            +datetime created_at
        }
        class UserLogin {
            +EmailStr email
            +str password
        }
        class TokenResponse {
            +str access_token
            +str token_type
        }
        class UserProfileUpdate {
            +list~str~ preferences
            +list~str~ allergies
        }
    }

    %% ── Recipe Schemas (schemas.py) ───────────────

    namespace RecipeSchemas {
        class NutritionEstimate {
            +int calories
            +str protein
            +str carbs
            +str fat
        }
        class RecipeRequest {
            +list~str~ ingredients
            +list~str~ preferences
            +list~str~ allergies
            +list~str~ validate_string_list(list~str~ values)$
            +list~str~ validate_ingredients_not_empty_after_cleaning(list~str~ values)$
            +list~str~ validate_optional_list_size(list~str~ values)$
        }
        class RecipeResponse {
            +int generated_recipe_id
            +str title
            +list~str~ ingredients
            +list~str~ additional_ingredients
            +list~str~ preferences
            +list~str~ allergies
            +list~str~ steps
            +NutritionEstimate nutrition_estimate
            +str image_url
            +str image_cache_key
            +list~str~ warnings
        }
        class SavedRecipeCreate {
            +int generated_recipe_id
        }
        class SavedRecipeResponse {
            +int id
            +str title
            +list~str~ ingredients
            +list~str~ additional_ingredients
            +list~str~ preferences
            +list~str~ allergies
            +list~str~ steps
            +NutritionEstimate nutrition
            +str image_url
            +str image_cache_key
            +datetime saved_at
            +datetime created_at
        }
        class GeneratedRecipeHistoryResponse {
            +int id
            +str fingerprint
            +str title
            +list~str~ ingredients
            +list~str~ additional_ingredients
            +list~str~ preferences
            +list~str~ allergies
            +list~str~ steps
            +NutritionEstimate nutrition
            +list~str~ warnings
            +str image_url
            +str image_cache_key
            +bool is_saved
            +datetime saved_at
            +datetime created_at
        }
        class PaginatedResponse~T~ {
            +list~T~ items
            +int total
            +int page
            +int page_size
            +int total_pages
        }
    }

    %% ── OCR Schemas (schemas.py) ──────────────────

    namespace OcrSchemas {
        class NutritionLabelData {
            +str product_name
            +str serving_size
            +int calories
            +float protein_g
            +float carbs_g
            +float fat_g
            +float sugar_g
            +float sodium_mg
            +float fiber_g
        }
        class OcrExtractionResponse {
            +str raw_text
            +NutritionLabelData structured_nutrition
            +str image_url
            +str image_path
        }
        class SavedOcrExtractionCreate {
            +str source_filename
            +str raw_text
            +NutritionLabelData structured_nutrition
            +str image_url
            +str image_path
        }
        class SavedOcrExtractionResponse {
            +int id
            +str source_filename
            +str raw_text
            +NutritionLabelData structured_nutrition
            +str image_url
            +datetime created_at
        }
    }

    %% ── RAG Debug Route Models (routes/rag_debug.py) ──

    namespace RagDebugRouteModels {
        class VectorSearchResult {
            +int rank
            +str recipe_id
            +str title
            +list~str~ ingredients
            +list~str~ tags
            +str instruction_summary
            +float semantic_score
            +int preference_matches
            +float ranking_score
            +bool allergy_conflict
            +bool selected_for_context
        }
        class RagDebugResponse {
            +str query_text
            +int collection_size
            +int candidates_retrieved
            +int candidates_after_allergy_filter
            +int candidates_selected
            +dict generation_restrictions
            +list~VectorSearchResult~ results
        }
    }

    %% ── Infrastructure (database/security/deps/utils) ──

    namespace InfrastructureLayer {
        class Database {
            <<module>>
            +Engine engine
            +sessionmaker SessionLocal
            +declarative_base Base
            +Generator~Session~ get_db()
        }
        class Security {
            <<module>>
            +str hash_password(str password)
            +bool verify_password(str plain_password, str hashed_password)
            +str create_access_token(dict data, int expires_minutes)
        }
        class Dependencies {
            <<module>>
            +User get_current_user(str token, Session db)
            +User? get_optional_current_user(str? token, Session db)
        }
        class Utils {
            <<module>>
            +Any load_serialized_value(str raw_value, Any fallback)
            +list~str~ load_serialized_list(str raw_value)
            +str build_recipe_fingerprint(str title, list~str~ ingredients, list~str~ preferences, list~str~ allergies, list~str~ steps)
        }
    }

    %% ── Configuration (config.py) ─────────────────

    namespace ConfigLayer {
        class Settings {
            +str openai_api_key
            +str openai_model
            +str openai_embedding_model
            +str openai_image_model
            +str ocr_provider
            +str google_application_credentials
            +str database_url
            +str secret_key
            +str algorithm
            +str frontend_origin
            +str recipe_corpus_path
            +str chroma_persist_directory
            +str chroma_collection_name
            +int rag_candidate_count
            +int rag_context_count
            +int embedding_batch_size
            +str recipe_thumbnail_directory
            +str ocr_upload_directory
            +int max_ocr_upload_bytes
            +int max_ocr_image_pixels
            +int default_rate_limit_requests
            +int default_rate_limit_window_seconds
            +int auth_rate_limit_requests
            +int auth_rate_limit_window_seconds
            +int generate_rate_limit_requests
            +int generate_rate_limit_window_seconds
            +int ocr_extract_rate_limit_requests
            +int ocr_extract_rate_limit_window_seconds
            +str secret_key_must_be_set(str value)$
        }
    }

    %% ═══════════════════════════════════════════════
    %%  RELATIONSHIPS
    %% ═══════════════════════════════════════════════

    %% ── Inheritance (class extends) ───────────────

    User --|> Base : extends
    GeneratedRecipe --|> Base : extends
    OcrExtraction --|> Base : extends
    Settings --|> BaseSettings : extends
    RateLimitMiddleware --|> BaseHTTPMiddleware : extends
    GoogleVisionOcrProvider --|> OcrProvider : extends
    OpenAIRecipeImageProvider --|> RecipeImageProvider : extends

    %% ── Composition (owns lifecycle) ──────────────

    User "1" *-- "0..*" GeneratedRecipe : owns
    User "1" *-- "0..*" OcrExtraction : owns
    RateLimitMiddleware "1" *-- "1" InMemoryRateLimiter : uses
    RecipeResponse "1" *-- "1" NutritionEstimate : contains
    SavedRecipeResponse "1" *-- "1" NutritionEstimate : contains
    GeneratedRecipeHistoryResponse "1" *-- "1" NutritionEstimate : contains
    OcrExtractionResponse "1" *-- "1" NutritionLabelData : contains
    SavedOcrExtractionCreate "1" *-- "1" NutritionLabelData : contains
    SavedOcrExtractionResponse "1" *-- "1" NutritionLabelData : contains
    RagDebugResponse "1" *-- "0..*" VectorSearchResult : contains

    %% ── Aggregation (references, shared lifecycle) ─

    RateLimitMiddleware "1" o-- "1..*" RateLimitRule : default + route rules

    %% ── Dependency: App composition ───────────────

    App ..> AuthRouter : includes router
    App ..> RecipeRouter : includes router
    App ..> OcrRouter : includes router
    App ..> RagDebugRouter : includes router
    App ..> RateLimitMiddleware : adds middleware

    %% ── Dependency: Routes → Services ─────────────

    RecipeRouter ..> LlmService : generates recipes
    RecipeRouter ..> RecipeImageService : creates thumbnails
    OcrRouter ..> OcrService : extracts nutrition
    RagDebugRouter ..> RagService : retrieves context
    RagDebugRouter ..> EmbeddingService : creates embeddings
    RagDebugRouter ..> VectorStoreService : queries collection

    %% ── Dependency: Routes → Infrastructure ───────

    AuthRouter ..> Security : hashes and verifies
    AuthRouter ..> Dependencies : authenticates user
    RecipeRouter ..> Dependencies : authenticates user
    OcrRouter ..> Dependencies : authenticates user

    %% ── Dependency: Service → Service ─────────────

    LlmService ..> RagService : retrieves context
    RagService ..> EmbeddingService : creates embeddings
    RagService ..> VectorStoreService : queries collection

    %% ── Dependency: Service → Provider ────────────

    OcrService ..> OcrProvider : obtains provider
    OcrService ..> OcrImageProcessing : preprocesses image
    RecipeImageService ..> RecipeImageProvider : obtains provider

    %% ── Dependency: Provider internals ────────────

    GoogleVisionOcrProvider ..> GoogleVisionHelper : delegates OCR

    %% ── Dependency: Infrastructure internals ──────

    Dependencies ..> Database : obtains session
    InMemoryRateLimiter ..> RateLimitRule : checks against
