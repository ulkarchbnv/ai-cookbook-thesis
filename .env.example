OPENAI_API_KEY=your_openai_key
OCR_PROVIDER=google_vision
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\your-google-service-account.json
DATABASE_URL=your_database_url
SECRET_KEY=your_secret
ALGORITHM=HS256
FRONTEND_ORIGIN=http://localhost:5173
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-1-mini
RECIPE_CORPUS_PATH=backend/data/recipes_subset.json
CHROMA_PERSIST_DIRECTORY=backend/data/chroma
CHROMA_COLLECTION_NAME=recipe_knowledge_base
RECIPE_THUMBNAIL_DIRECTORY=backend/media/recipe_thumbnails
RAG_CANDIDATE_COUNT=10
RAG_CONTEXT_COUNT=3
EMBEDDING_BATCH_SIZE=100
MAX_OCR_UPLOAD_BYTES=5242880
MAX_OCR_IMAGE_PIXELS=20000000
DEFAULT_RATE_LIMIT_REQUESTS=60
DEFAULT_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
GENERATE_RATE_LIMIT_REQUESTS=15
GENERATE_RATE_LIMIT_WINDOW_SECONDS=900
OCR_EXTRACT_RATE_LIMIT_REQUESTS=10
OCR_EXTRACT_RATE_LIMIT_WINDOW_SECONDS=900
VITE_API_BASE_URL=http://127.0.0.1:8000
